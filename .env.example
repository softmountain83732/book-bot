# ==============================================================================
# HBTU Book Marketplace - Environment Configuration (.env.example)
# ==============================================================================

# --- Telegram Bot Credentials ---
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
BOT_USERNAME=hbtu_books_bot

# --- MongoDB Database ---
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=hbtu_book_marketplace

# --- Channel Integration ---
CHANNEL_ID=-1001234567890
CHANNEL_JOIN_URL=https://t.me/your_channel_invite

# --- Admin Authorization ---
# Comma-separated list of Telegram user IDs with administrator privileges
ADMIN_IDS=123456789,987654321

# --- Mini App & Web API Configuration ---
# JWT secret key for signing user sessions
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRE_HOURS=72

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=https://minapp.example.com,https://t.me,http://localhost:5173

# API Listening Configuration
API_HOST=0.0.0.0
API_PORT=8000

# --- Frontend Mini App Configuration ---
# Public Telegram contact URL for the Contact Admin button (e.g. https://t.me/your_admin_username)
VITE_ADMIN_CONTACT_URL=https://t.me/your_admin_username
